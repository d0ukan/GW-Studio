<Window x:Class="Dou_GW_Studio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:Dou_GW_Studio.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="GW Studio — Made by Dou" Width="1280" Height="900" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="Assets/AppIcon.ico" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="{DynamicResource SurfaceBrush}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Image Source="/Assets/AppIcon.png" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="GW STUDIO  /  INSTRUMENT CONTROL" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Click="Minimize_Click" ToolTip="Minimize" Padding="14,0" Margin="0"/><Button Content="□" Click="Maximize_Click" ToolTip="Maximize / Restore" Padding="14,0" Margin="0"/><Button Content="✕" Click="Close_Click" ToolTip="Close" Padding="14,0" Margin="0"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="22,16,22,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,15"><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,11,0"><Image Source="/Assets/AppIcon.png" Stretch="Uniform" Margin="3"/></Border><TextBlock Text="{Binding DetectedModel}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="GW Studio" Foreground="{DynamicResource SecondaryBrush}" FontSize="23" Margin="10,0,0,0"/><TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="12,9,0,0"/></StackPanel><TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding CanChoosePort}" ToolTip="USB CDC virtual COM port"/>
    <TextBlock Grid.Column="1" Text="115200 · 8N1 · LF" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="14,0"/>
    <Button Grid.Column="2" Content="REFRESH" Command="{Binding RefreshPortsCommand}"/>
    <Button Grid.Column="3" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}"/>
    <TextBlock Grid.Column="4" Text="{Binding Identity}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
    <Button Grid.Column="5" Content="{Binding UiModeLabel}" Click="UiMode_Click" Margin="0,0,8,0" ToolTip="Switch between Compact bench-control view and Advanced diagnostics/automation view."/>
    <Button Grid.Column="6" Content="704" Click="Mil704_Click" Margin="0,0,10,0" ToolTip="Open the simple MIL-STD-704 waveform lab."/>
    <Button Grid.Column="7" Content="ALL OUTPUT OFF" Command="{Binding AllOffCommand}" Style="{StaticResource DangerButton}" Margin="0" ToolTip="Emergency-style OFF: cancels pending actions, sends OFF to every channel exposed by the detected model, and verifies all states."/>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,12,0,0">
    <TextBlock Text="QUICK OUTPUTS" Style="{StaticResource Label}" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <WrapPanel>
     <ToggleButton Content="ALL ON / OFF" IsChecked="{Binding AllOutputsOn, Mode=OneWay}" Command="{Binding AllOutputToggleCommand}" Style="{StaticResource OutputToggleButton}" ToolTip="Safety-first ALL toggle: if any channel is ON, the first press turns ALL channels OFF. Only when all channels are OFF will the next press turn them all ON."/>
     <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,3,0" VerticalAlignment="Top">
       <ToggleButton Content="{Binding QuickOutputLabel}" IsChecked="{Binding OutputOn, Mode=OneWay}" Command="{Binding QuickOutputCommand}" Style="{StaticResource OutputToggleButton}"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0" ToolTip="Live measured output voltage / current; not the requested setpoints.">
        <TextBlock Text="{Binding ActualVoltage}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text=" V  /  " Foreground="{DynamicResource SecondaryBrush}" FontSize="11"/>
        <TextBlock Text="{Binding ActualCurrent}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text=" A" Foreground="{DynamicResource SecondaryBrush}" FontSize="11"/>
       </StackPanel>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </WrapPanel>
   </DockPanel>
  </Grid></Border>
  <TabControl x:Name="MainTabs" Grid.Row="2"><TabItem x:Name="DashboardTab" Header="▦  Dashboard"><v:DashboardView/></TabItem><TabItem x:Name="Mil704Tab" Header="704  Lab"><v:Mil704View/></TabItem><TabItem Header="⌁  Live Graph" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><v:LiveGraphView/></TabItem><TabItem Header="⚡  Custom" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><v:CustomView/></TabItem><TabItem Header="≡  Sequence" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><v:SequenceView/></TabItem><TabItem Header="▤  Logger" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><v:LoggerView/></TabItem><TabItem Header=">_  Terminal" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><v:TerminalView/></TabItem><TabItem Header="⚙  Settings"><v:SettingsView/></TabItem><TabItem Header="?  Help"><v:HelpView/></TabItem></TabControl>
  <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,10"><TextBlock Text="{Binding Message}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
 </Grid></Border>
</Window>
