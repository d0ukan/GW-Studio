<Window x:Class="Dou_GW_Studio.Mil704GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="GW Studio — 704 Graph"
        Width="1500" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="704 REQUESTED vs MEASURED" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock Text="Move this window between monitors, resize it, maximize/minimize it, or use true full screen." Style="{StaticResource Muted}"/>
   </StackPanel>
   <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
    <CheckBox Content="Show measured" IsChecked="{Binding ShowMeasured}" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Button Content="CLEAR MEASURED" Command="{Binding ClearMeasuredCommand}" Padding="8,3"/>
    <Button Content="EXPORT PNG" Click="ExportPng_Click" Padding="8,3" Margin="8,0,0,0"/>
    <Button x:Name="FullScreenButton" Content="FULL SCREEN" Click="FullScreen_Click" Margin="8,0,0,0"/>
    <Button Content="MINIMIZE" Click="Minimize_Click"/>
    <Button x:Name="MaximizeButton" Content="MAXIMIZE" Click="MaximizeRestore_Click"/>
    <Button Content="CLOSE" Click="Close_Click"/>
   </WrapPanel>
  </DockPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="5">
    <oxy:PlotView x:Name="FullPlot" Background="{DynamicResource CardBrush}"
                  DefaultTrackerTemplate="{StaticResource DarkTrackerTemplate}"/>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10" VerticalAlignment="Top">
    <StackPanel>
     <TextBlock Text="RUN" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
     <Button Content="{Binding ArmLabel}" Command="{Binding ArmCommand}" Padding="8,5" Margin="0,0,0,6"/>
     <Button Content="RUN" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Padding="8,5" Margin="0,0,0,6"/>
     <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Padding="8,5" Margin="0,0,0,6"/>
     <Button Content="EXPORT PNG" Click="ExportPng_Click" Padding="8,5"/>
     <Separator Margin="0,10,0,8"/>
     <TextBlock Text="Repeat" Style="{StaticResource Label}"/>
     <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
     <TextBlock Text="Delay / ms" Style="{StaticResource Label}"/>
     <TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
   </Border>
  </Grid>

  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,10,0,0">
   <StackPanel>
    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
