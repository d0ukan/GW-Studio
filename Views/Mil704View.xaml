<UserControl x:Class="Dou_GW_Studio.Views.Mil704View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
 <ScrollViewer x:Name="LabScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               PanningMode="VerticalOnly" CanContentScroll="False" Focusable="False">
 <Grid DataContext="{Binding Mil704}" Margin="12,10,18,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
   <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="GRAPH" Click="JumpToGraph_Click" Padding="10,4" Margin="0,0,6,0" ToolTip="Jump to the requested/measured graph."/>
    <Button Content="EDITORS" Click="JumpToEditors_Click" Padding="10,4" Margin="0,0,6,0" ToolTip="Jump to the waveform builders and editors."/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="5" Padding="8,5" VerticalAlignment="Center"><TextBlock Text="PC TIMED • VERIFY WITH SCOPE" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="10"/></Border>
   </WrapPanel>
   <StackPanel><TextBlock Text="704 Lab" Style="{StaticResource Heading}"/>
    <TextBlock Text="MIL-STD-704 bench waveforms • not a compliance certifier" Foreground="{DynamicResource SecondaryBrush}" FontSize="11"/></StackPanel>
  </DockPanel>

  <Border x:Name="EditorsSection" Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
   <TabControl>
    <TabItem Header="QUICK BUILDER">
     <StackPanel Margin="10">
      <DockPanel Margin="0,0,0,10">
       <WrapPanel>
        <StackPanel Width="300" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="QUICK TEMPLATE"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"/></StackPanel>
        <Button Content="LOAD TEMPLATE" Command="{Binding ApplyTemplateCommand}" VerticalAlignment="Bottom"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="10,18,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
       </WrapPanel>
       <TextBlock DockPanel.Dock="Right" Text="Preview may exceed PSU range; ARM checks actual connected channel limits." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,10">
       <StackPanel Width="78" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="CHANNEL"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"/></StackPanel>
       <StackPanel Width="190" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="CURVE"/><ComboBox ItemsSource="{Binding Curves}" SelectedItem="{Binding Curve}"/></StackPanel>
       <StackPanel Width="110" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="START / V"/><TextBox Text="{Binding StartVoltage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fixed by the image equation; use Custom Points for other values."><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsImageEquation}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
       <StackPanel Width="110" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="END / V"/><TextBox Text="{Binding EndVoltage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fixed by the image equation; use Custom Points for other values."><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsImageEquation}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
       <StackPanel Width="105" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="RAMP / s"/><TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fixed by the image equation; use Custom Points for other values."><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsImageEquation}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
       <StackPanel Width="110" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="CURRENT / A"/><TextBox Text="{Binding CurrentLimit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Width="100" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="STEP / ms"/><TextBox Text="{Binding StepMs, UpdateSourceTrigger=PropertyChanged}" ToolTip="Discrete setpoint interval. Minimum 20 ms. Real timing also depends on Windows, USB/serial and the instrument."/></StackPanel>
       <StackPanel Width="100" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="PRE / s"/><TextBox Text="{Binding PreHoldSeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fixed by the image equation; use Custom Points for other values."><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsImageEquation}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
       <StackPanel Width="100" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="POST / s"/><TextBox Text="{Binding PostHoldSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <Button Content="BUILD CURVE" Command="{Binding BuildCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0"/>
      </WrapPanel>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,9">
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsImageEquation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock Text="{Binding EquationHint}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="11"/>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
        <StackPanel><TextBlock Text="CUSTOM POINTS" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock Text="Use time=voltage pairs. Example: 0=28; 0.05=28; 0.10=20; 0.20=20" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="BUILD POINTS" Command="{Binding BuildCustomPointsCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding CustomPoints, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
       </Border>
       <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
        <StackPanel><TextBlock Text="POWER INTERRUPT" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock Text="Turns the selected channel output OFF for the entered duration, then restores nominal voltage." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="BUILD INTERRUPT" Command="{Binding BuildInterruptCommand}" Margin="8,0,0,0"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding InterruptMs, UpdateSourceTrigger=PropertyChanged}" Width="90"/><TextBlock Text=" ms" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel></DockPanel></StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </TabItem>

    <TabItem Header="704 TEST LIBRARY">
     <Grid Margin="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="READY PROFILES" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
       <TextBlock Text="Choose a bench profile and load it without entering individual values." Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
       <ListBox ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}" DisplayMemberPath="Name" Height="170"/>
       <Button Content="LOAD SELECTED PROFILE" Command="{Binding ApplyLibraryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
      </StackPanel>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
       <StackPanel>
        <TextBlock Text="{Binding SelectedLibraryItem.Category}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock Text="{Binding SelectedLibraryItem.Name}" FontWeight="SemiBold" FontSize="21" Margin="0,6,0,8"/>
        <TextBlock Text="{Binding SelectedLibraryItem.Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,14,0,0"><TextBlock Text="These are convenient bench starting points, not certified standard limits. Verify the applicable MIL-STD-704 revision, aircraft power category and test method before execution." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></Border>
       </StackPanel>
      </Border>
     </Grid>
    </TabItem>

    <TabItem Header="SEGMENT EDITOR">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
       <WrapPanel><Button Content="+ HOLD" Command="{Binding AddHoldSegmentCommand}"/><Button Content="+ LINEAR RAMP" Command="{Binding AddLinearSegmentCommand}"/><Button Content="+ EXP RAMP" Command="{Binding AddExponentialSegmentCommand}"/><Button Content="+ OUTPUT OFF" Command="{Binding AddInterruptSegmentCommand}"/><Button Content="DELETE" Command="{Binding DeleteSegmentCommand}" Style="{StaticResource DangerButton}"/><Button Content="↑" Command="{Binding MoveSegmentUpCommand}"/><Button Content="↓" Command="{Binding MoveSegmentDownCommand}"/></WrapPanel>
       <Button DockPanel.Dock="Right" Content="BUILD SEGMENTS" Command="{Binding BuildSegmentsCommand}" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column" MinHeight="170">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="TYPE" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.SegmentTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="START / V" Binding="{Binding StartVoltage, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
        <DataGridTextColumn Header="END / V" Binding="{Binding EndVoltage, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
        <DataGridTextColumn Header="DURATION / ms" Binding="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
        <DataGridTextColumn Header="" Width="*" IsReadOnly="True"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="Example: 28 V hold → 32 V hold → 32→24 V ramp → 20 V hold → 28 V recovery" Style="{StaticResource Muted}" Margin="0,0,12,10"/>
     </Grid>
    </TabItem>

    <TabItem Header="DRAG EDITOR">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
       <StackPanel><TextBlock Text="DRAG-TO-EDIT WAVEFORM" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Load the current waveform, drag cyan control points with the mouse, then use it as the requested profile. Use + POINT for extra control points (maximum 64). Select/drag with left mouse; REMOVE POINT deletes the selected interior point. Editing uses a lightweight plot-update path." Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
       <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="LOAD CURRENT" Command="{Binding LoadCurrentIntoDragCommand}"/><Button Content="+ POINT" Click="AddDragPoint_Click" ToolTip="Insert a new control point beside the selected point, or in the widest interval."/><Button Content="REMOVE POINT" Click="RemoveDragPoint_Click" ToolTip="Remove the selected interior control point. First/last points are retained."/><Button Content="RESET" Command="{Binding ResetDragCommand}"/><Button Content="USE DRAG WAVEFORM" Command="{Binding UseDragWaveformCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
      </DockPanel>
      <Grid Grid.Row="1">
       <oxy:PlotView x:Name="DragPlot" Model="{Binding DragEditModel}" Background="{DynamicResource CardBrush}"
                     PreviewMouseLeftButtonDown="DragPlot_MouseLeftButtonDown"
                     PreviewMouseMove="DragPlot_MouseMove"
                     PreviewMouseLeftButtonUp="DragPlot_MouseLeftButtonUp"
                     MouseLeave="DragPlot_MouseLeave"/>
       <Border x:Name="DragInfoOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,14,0,0"
               Background="#E6171E28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5"
               Padding="9,6" IsHitTestVisible="False" Visibility="Collapsed">
        <TextBlock x:Name="DragInfoText" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12"/>
       </Border>
      </Grid>
     </Grid>
    </TabItem>
   </TabControl>
  </Border>

  <!-- Single page-level scrollbar: graph, RUN and SAVE/LOAD all take natural layout height. -->
  <Grid x:Name="GraphSection" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <!-- Keep the plot at a predictable size; the panel on the right can grow below it. -->
   <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0" Height="465" MinHeight="380" VerticalAlignment="Top">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="6,2,6,6"><TextBlock Text="Requested profile and actual PSU measurement are overlaid on the same time axis." Style="{StaticResource Muted}" VerticalAlignment="Center"/><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><CheckBox Content="Show measured" IsChecked="{Binding ShowMeasured}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="CLEAR MEASURED" Command="{Binding ClearMeasuredCommand}" Padding="8,3"/><Button Content="EXPORT PNG" Click="ExportPng_Click" Padding="10,3" Margin="8,0,0,0" ToolTip="Save the current requested/measured 704 graph as a PNG image."/><Button Content="FULL SCREEN" Click="OpenFullScreen_Click" Padding="10,3" Margin="8,0,0,0" ToolTip="Open the 704 requested/measured graph in a movable full-screen-capable window."/></WrapPanel></DockPanel>
     <oxy:PlotView Grid.Row="1" Model="{Binding PreviewModel}" Background="{DynamicResource CardBrush}"
                   DefaultTrackerTemplate="{StaticResource DarkTrackerTemplate}"/>
    </Grid>
   </Border>
   <!-- RUN stays next to the graph; SAVE / LOAD follows immediately below it. -->
   <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Top">
    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="RUN" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="REPEAT"/><TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="1–100 loops"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="DELAY / ms"/><TextBox Text="{Binding RepeatDelayMs, UpdateSourceTrigger=PropertyChanged}" ToolTip="Delay between loops. Final channel state is retained during the delay."/></StackPanel></Grid>
      <Button Content="{Binding ArmLabel}" Command="{Binding ArmCommand}"/><Button Content="RUN WAVEFORM" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="STOP / OUTPUT OFF" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"/>
      <TextBlock Text="Repeat expansion happens only when ARM is pressed. Preview/editors remain lightweight. ARM validates all generated points against the detected GPP channel." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="12">
     <StackPanel><TextBlock Text="SAVE / LOAD" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/><TextBlock Style="{StaticResource Label}" Text="PROFILE NAME"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/><Button Content="SAVE" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,10"/><ListBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedSavedProfile}" DisplayMemberPath="Display" Height="95"/><WrapPanel Margin="0,8,0,0"><Button Content="LOAD" Command="{Binding LoadCommand}"/><Button Content="DELETE" Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel>
    </Border>
   </StackPanel>
  </Grid>

  <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 </Grid>
 </ScrollViewer>
</UserControl>
