<UserControl x:Class="Dou_GW_Studio.Views.TerminalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Dou_GW_Studio.Controls">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Style="{StaticResource Heading}" Text="Command terminal"/>
 <TextBlock Grid.Row="1" Foreground="{DynamicResource WarningBrush}" Text="Direct commands can change outputs and bypass dashboard limits. One ASCII command per send; LF is appended automatically. Query commands contain ?." Margin="0,0,0,16"/>
 <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" IsEnabled="{Binding CanControl}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="SEND" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/></Grid>
 <DataGrid Grid.Row="3" ItemsSource="{Binding TrafficView}" IsReadOnly="True" FontFamily="Consolas" RowHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120"/><DataGridTemplateColumn Header="Dir" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Direction}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Direction}" Value="TX"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Direction}" Value="RX"><Setter Property="Foreground" Value="{DynamicResource Channel2Brush}"/></DataTrigger><DataTrigger Binding="{Binding Direction}" Value="ERR"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Command / Response" Binding="{Binding Text}" Width="*"/></DataGrid.Columns></DataGrid>
 <WrapPanel Grid.Row="4" Margin="0,12,0,16"><CheckBox Content="Hide polling traffic" IsChecked="{Binding HidePolling}"/><Button Content="CLEAR LOG" Command="{Binding ClearTerminalCommand}"/><TextBlock Style="{StaticResource Muted}" Text="Last 500 communication entries retained." VerticalAlignment="Center"/></WrapPanel>
</Grid>
</UserControl>
