<UserControl x:Class="Dou_GW_Studio.Views.CustomView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Dou_GW_Studio.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <DockPanel><TextBlock Style="{StaticResource Heading}" Text="Custom tests"/><Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="12,6"><TextBlock Text="PC TIMED" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/></Border></DockPanel>
 <TextBlock Foreground="{DynamicResource WarningBrush}" Text="PC-timed execution is not deterministic. Windows scheduling, USB/serial communication, polling and instrument response can change actual transition timing." Margin="0,4,0,16"/>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
  <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="ⓘ Parameter help: hover the information symbols next to fields. BASE = normal voltage, STEP = temporary voltage, ON/STEP TIME = active duration, OFF TIME = interval between cycles, INITIAL DELAY = wait before the main event, REPEAT = cycle count."/>
 </Border>
 <StackPanel DataContext="{Binding Custom}">
 <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="01  /  Build a timeline" FontSize="16" FontWeight="SemiBold"/>
  <WrapPanel Margin="0,10,0,4"><StackPanel Width="150" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="PRESET"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Pulse: timed ON pulse. Voltage Step: temporary voltage change. Power Cycle: repeated ON/OFF. Custom Timeline: manual steps." VerticalAlignment="Center"/></WrapPanel><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/></StackPanel><StackPanel Width="85" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="CHANNEL"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Select which programmable source channel this preset targets." VerticalAlignment="Center"/></WrapPanel><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"/></StackPanel>
   <StackPanel Width="125" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="BASE VOLTAGE / V"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Normal/source voltage used before and after a voltage step. The detected model profile enforces the selected channel's limit." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding Voltage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="125" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="STEP VOLTAGE / V"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Temporary target voltage for Voltage Step mode. Limit depends on the detected model and selected channel." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding StepVoltage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="125" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="CURRENT LIMIT / A"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Current limit sent with generated steps. The detected model profile enforces the selected channel's limit." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding Current, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  </WrapPanel>
  <WrapPanel>
   <StackPanel Width="145" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="ON / STEP TIME / ms"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Pulse/Power Cycle: output ON duration. Voltage Step: time spent at the step voltage. PC timed; not hardware deterministic." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding OnMs, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="125" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="OFF TIME / ms"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="OFF interval between repeated pulse/power-cycle periods." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding OffMs, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="125" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="INITIAL DELAY / ms"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Delay before the main pulse/step starts. In Voltage Step mode the base voltage is applied during this interval." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="85" Margin="0,0,12,0"><WrapPanel><TextBlock Style="{StaticResource Label}" Text="REPEAT"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Number of pulse/power-cycle repetitions. Voltage Step uses a single step in the current preset builder." VerticalAlignment="Center"/></WrapPanel><TextBox Text="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  </WrapPanel>
  <WrapPanel Margin="0,12,0,10"><CheckBox Content="Initial output ON" IsChecked="{Binding InitialOn}"/><CheckBox Content="Final output ON" IsChecked="{Binding FinalOn}"/><CheckBox Content="Step: return to base" IsChecked="{Binding ReturnToBase}"/></WrapPanel>
  <WrapPanel><Button Content="BUILD TIMELINE" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Style="{StaticResource Muted}" Text="Pulse / Cycle: initial &amp; final state. Voltage Step: starts ON and stays ON." VerticalAlignment="Center"/></WrapPanel>
  <TextBlock Style="{StaticResource Muted}" Text="Preset changes take effect only when BUILD TIMELINE is pressed. RUN always executes the table below." FontSize="11" Margin="0,10,0,0"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="02  /  Review every transition" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <WrapPanel Margin="0,0,0,12"><Button Content="ADD STEP" Command="{Binding AddCommand}"/><Button Content="DUPLICATE" Command="{Binding DuplicateCommand}"/><Button Content="DELETE SELECTED" Click="DeleteSelected_Click"/><Button Content="↑ MOVE UP" Command="{Binding UpCommand}"/><Button Content="↓ MOVE DOWN" Command="{Binding DownCommand}"/></WrapPanel>
  <DataGrid x:Name="TransitionGrid" ItemsSource="{Binding Steps}" SelectedItem="{Binding Selected}" Height="250" IsEnabled="{Binding CanEdit}" SelectionMode="Extended" SelectionUnit="FullRow">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Step" Binding="{Binding Number}" IsReadOnly="True" Width="60"/>
    <DataGridTemplateColumn Header="Channel" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Channels, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Voltage / V" Binding="{Binding Voltage, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridTextColumn Header="Current limit / A" Binding="{Binding Current, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridCheckBoxColumn Header="Output ON" Binding="{Binding OutputOn, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
    <DataGridTextColumn Header="Duration / ms" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Style="{StaticResource Muted}" Text="Ctrl/Shift-click to select multiple rows; DELETE SELECTED removes them together. Execution order is top to bottom. OFF rows switch off before applying setpoints. A completed profile retains its final row state. STOP turns off involved channels." FontSize="11" Margin="0,10,0,10"/>
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <WrapPanel><TextBlock Style="{StaticResource Label}" Text="PROFILE NAME"/><TextBlock Text=" ⓘ" Foreground="{DynamicResource AccentBrush}" ToolTip="Profiles are stored in the application's private profile library. You do not need to browse Windows folders." VerticalAlignment="Center"/></WrapPanel>
    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
    <Button Content="SAVE TO LIBRARY" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <DockPanel><TextBlock Style="{StaticResource Label}" Text="SAVED PROFILES"/><Button DockPanel.Dock="Right" Content="REFRESH" Command="{Binding RefreshProfilesCommand}" Padding="9,5" Margin="0,0,0,5"/></DockPanel>
    <ListBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedProfile}" Height="128" DisplayMemberPath="Display"/>
    <WrapPanel Margin="0,10,0,0"><Button Content="LOAD SELECTED" Command="{Binding LoadCommand}"/><Button Content="DELETE SELECTED" Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButton}"/><TextBlock Style="{StaticResource Muted}" Text="Select saved profiles directly here; no file path is required." VerticalAlignment="Center"/></WrapPanel>
   </StackPanel>
  </Grid>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel>
  <WrapPanel><Button Content="{Binding ArmLabel}" Command="{Binding ArmCommand}"/><Button Content="RUN PROFILE" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"/></WrapPanel>
  <TextBlock Text="{Binding Status}" Margin="0,14,0,0" Foreground="{DynamicResource AccentBrush}"/>
 </StackPanel></Border>
 </StackPanel>
 <TextBlock Text="Live readbacks during the test" FontSize="16" Margin="0,0,0,12"/>
 <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,14"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,14,0"/><TextBlock Text="{Binding ActualVoltage, StringFormat='{}{0} V'}" FontFamily="Consolas" Margin="0,0,18,0"/><TextBlock Text="{Binding ActualCurrent, StringFormat='{}{0} A'}" FontFamily="Consolas"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <c:GraphPanel DataContext="{Binding Graph}"/>
</StackPanel></ScrollViewer>
</UserControl>
