<UserControl x:Class="Dou_GW_Studio.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Dou_GW_Studio.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Settings"/>
 <TextBlock Style="{StaticResource Muted}" Text="Connection policy and measurement preferences." Margin="0,0,0,20"/>
 <Border Style="{StaticResource Card}"><StackPanel MaxWidth="700" HorizontalAlignment="Left"><TextBlock Text="Acquisition &amp; communication" FontSize="17" FontWeight="SemiBold"/>
 <WrapPanel Margin="0,12,0,12"><StackPanel Width="240" Margin="0,0,20,0"><TextBlock Style="{StaticResource Label}" Text="POLLING INTERVAL / ms"/><TextBox Text="{Binding PollText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="240"><TextBlock Style="{StaticResource Label}" Text="SERIAL TIMEOUT / ms"/><TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
 <TextBlock Style="{StaticResource Muted}" Text="1–10000 ms. This is the minimum delay after a complete measurement sweep; it does NOT guarantee the same sample period. Actual acquisition speed depends on serial transactions and instrument response. Measurement storage runs independently while WPF rendering is throttled to stay responsive."/>
 <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,4">
  <StackPanel><TextBlock Style="{StaticResource Label}" Text="ACTUAL ACQUISITION"/><TextBlock Text="{Binding AcquisitionStatus}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 </Border>
 <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,4">
  <StackPanel><TextBlock Style="{StaticResource Label}" Text="CONNECTION HEALTH"/><TextBlock Text="{Binding ConnectionHealth}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" Text="Lightweight counters only; no extra instrument queries are generated for this panel."/></StackPanel>
 </Border>
 <CheckBox Content="Monitor and control CH2 (change while disconnected)" IsChecked="{Binding MonitorCh2}" Margin="0,18,0,6"/>
 <CheckBox Content="Monitor and control CH3 (change while disconnected)" IsChecked="{Binding MonitorCh3}" Margin="0,6,0,6" Visibility="{Binding HasChannel3, Converter={StaticResource BoolVisibility}}"/>
 <CheckBox Content="Monitor and control CH4 (change while disconnected)" IsChecked="{Binding MonitorCh4}" Margin="0,6,0,6" Visibility="{Binding HasChannel4, Converter={StaticResource BoolVisibility}}"/>
 <CheckBox Content="Automatically reconnect after an unexpected USB/serial connection loss" IsChecked="{Binding AutoReconnect}" Margin="0,12,0,6"/>
 <TextBlock Style="{StaticResource Muted}" Text="When enabled, the app retries the same COM port after a real link fault. A deliberate DISCONNECT never auto-reconnects." Margin="22,0,0,8"/>
 <CheckBox Content="Turn all outputs OFF on disconnect / application close" IsChecked="{Binding OffOnDisconnect}" Margin="0,6,0,6"/>
 <TextBlock Style="{StaticResource Muted}" Text="Default is unchecked: connection and disconnection preserve existing output state. Closing an active custom test stops that test and turns off involved channels." Margin="0,4,0,18"/>
 <Button Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding UiModeHint}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,3"/><TextBlock Text="DARK  /  Segoe UI + Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,8"/><TextBlock Style="{StaticResource Muted}" Text="Dark is the supported theme. Colors and control styles are centralized in DarkTheme.xaml."/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Detected device capabilities" FontSize="17" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" Text="{Binding DeviceSummary}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Foreground="{DynamicResource WarningBrush}" Text="Channel count, voltage/current limits, auxiliary-channel behavior and compatible saved profiles are selected only after a verified *IDN? response." TextWrapping="Wrap"/></StackPanel></Border>

 <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="12" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,18,0"><Image Source="/Assets/AppIcon.png" Stretch="Uniform" Margin="5"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="GW Studio" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Made by Dou" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Auto-detecting bench control for GW Instek GPP-3060 and GPP-4323." Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding Version}" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel></Grid></Border>
</StackPanel></ScrollViewer>
</UserControl>
