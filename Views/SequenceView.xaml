<UserControl x:Class="Dou_GW_Studio.Views.SequenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Sequence}">
 <TextBlock Style="{StaticResource Heading}" Text="Native sequence"/>
 <TextBlock Style="{StaticResource Muted}" Text="Runs inside the GPP. Native step duration is 1–300 seconds; use Custom / PC Timed for millisecond requests." Margin="0,0,0,20"/>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="GPP NATIVE SEQUENCE" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="17"/>
  <WrapPanel Margin="0,14,0,14">
   <StackPanel Width="100" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="CHANNEL"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"/></StackPanel>
   <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="CYCLES"/><TextBox Text="{Binding Cycles}"/></StackPanel>
   <CheckBox Content="Infinite" IsChecked="{Binding Infinite}" VerticalAlignment="Bottom" Margin="0,0,18,8"/>
   <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="START GROUP"/><TextBox Text="{Binding StartGroup}"/></StackPanel>
   <StackPanel Width="140"><TextBlock Style="{StaticResource Label}" Text="END STATE"/><ComboBox ItemsSource="{Binding EndStates}" SelectedItem="{Binding EndState}"/></StackPanel>
  </WrapPanel>
  <WrapPanel Margin="0,0,0,12"><Button Content="ADD STEP" Command="{Binding AddCommand}"/><Button Content="DUPLICATE" Command="{Binding DuplicateCommand}"/><Button Content="DELETE" Command="{Binding DeleteCommand}"/></WrapPanel>
  <DataGrid ItemsSource="{Binding Steps}" SelectedItem="{Binding Selected}" Height="300" IsEnabled="{Binding CanEdit}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Step" Binding="{Binding Number}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="Voltage / V" Binding="{Binding Voltage, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridTextColumn Header="Current / A" Binding="{Binding Current, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridTextColumn Header="Duration / s" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Style="{StaticResource Muted}" Text="UPLOAD writes the table to the selected channel while its output is OFF. ENABLE SEQUENCE enables the GPP sequence engine but does not automatically turn the channel output ON. Use the global CH output control explicitly." TextWrapping="Wrap" Margin="0,12,0,12"/>
  <WrapPanel><Button Content="UPLOAD TO GPP" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="ENABLE SEQUENCE" Command="{Binding EnableCommand}"/><Button Content="RESTART" Command="{Binding RestartCommand}"/><Button Content="STOP / DISABLE" Command="{Binding DisableCommand}" Style="{StaticResource DangerButton}"/></WrapPanel>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
 </StackPanel></Border>
</StackPanel></ScrollViewer>
</UserControl>
