<UserControl x:Class="Dou_GW_Studio.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Dou_GW_Studio.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock Style="{StaticResource Heading}" Text="Bench overview"/>
 <TextBlock Style="{StaticResource Muted}" Text="{Binding UiModeHint}" TextWrapping="Wrap" Margin="0,0,0,20"/>
 <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ChannelCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

 <Border Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Card}" Margin="0,0,12,14"><StackPanel DataContext="{Binding Operating}">
  <DockPanel><StackPanel><TextBlock Text="CH1 / CH2 operating modes" FontSize="17" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" Text="Mode changes require CH1 and CH2 outputs OFF. The application never uses FAST relay switching." Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="READ DEVICE MODE" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/></DockPanel>
  <Grid Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Style="{StaticResource Label}" Text="SOURCE CONFIGURATION"/><ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}"/></StackPanel>
   <Button Grid.Column="1" Content="APPLY CONFIGURATION" Command="{Binding ApplyConfigurationCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="12,0,12,0"/>
   <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="Independent / TrackingSeries / TrackingParallel. Series and parallel are not available while a channel is in LOAD mode." VerticalAlignment="Center" TextWrapping="Wrap"/>
  </Grid>
  <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="CH1 FUNCTION" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ChannelModes}" SelectedItem="{Binding Ch1Mode}" Margin="0,6,0,8"/><TextBlock Style="{StaticResource Label}" Text="LOAD SETPOINT"/><DockPanel><TextBox Text="{Binding Ch1LoadSetpoint, UpdateSourceTrigger=PropertyChanged}" Width="170"/><TextBlock Text="{Binding Ch1LoadUnit}" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel><Button Content="APPLY CH1 MODE" Command="{Binding ApplyCh1ModeCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="CH2 FUNCTION" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ChannelModes}" SelectedItem="{Binding Ch2Mode}" Margin="0,6,0,8"/><TextBlock Style="{StaticResource Label}" Text="LOAD SETPOINT"/><DockPanel><TextBox Text="{Binding Ch2LoadSetpoint, UpdateSourceTrigger=PropertyChanged}" Width="170"/><TextBlock Text="{Binding Ch2LoadUnit}" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel><Button Content="APPLY CH2 MODE" Command="{Binding ApplyCh2ModeCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
  <TextBlock Style="{StaticResource Muted}" Text="LOAD CV uses voltage setpoint, LOAD CC uses current setpoint, LOAD CR uses resistance (1–1000 Ω). Output remains OFF after a mode change until you explicitly enable it." Margin="0,8,0,0" TextWrapping="Wrap"/>
 </StackPanel></Border>
</StackPanel></ScrollViewer>
</UserControl>
