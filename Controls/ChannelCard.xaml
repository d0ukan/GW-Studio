<UserControl x:Class="Dou_GW_Studio.Controls.ChannelCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}" Margin="0,0,12,14">
  <StackPanel>
   <DockPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
     <Border Margin="10,0,0,0" CornerRadius="5" Padding="8,4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock Text="{Binding OperatingModeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
     <Border Margin="7,0,0,0" CornerRadius="5" Padding="8,4" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ChannelStatus}" Value="OFF"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CV"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CC"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CR"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="TRIP"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="ERROR"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="{Binding ChannelStatus}" FontSize="11" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ChannelStatus}" Value="OFF"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CV"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CC"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="CR"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="TRIP"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding ChannelStatus}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Border>
     <Button Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" Content="{Binding LockText}" Command="{Binding ToggleLockCommand}" Margin="12,0,0,0" Padding="8,4" ToolTip="UI-only lock. Prevents editing/applying setpoints but does not change the instrument or disable output control."/>
    </StackPanel>
    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" CornerRadius="4" Padding="9,5" Background="{DynamicResource SurfaceBrush}"><TextBlock Text="{Binding OutputText}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding OutputOn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
   </DockPanel>
   <TextBlock Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Label}" Text="{Binding RatingText}" Margin="0,12,0,14"/>

   <Grid Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActualVoltage}" FontFamily="Consolas" FontSize="42" FontWeight="SemiBold"/><TextBlock Text=" V" VerticalAlignment="Bottom" Margin="2,0,0,9" Foreground="{DynamicResource SecondaryBrush}" FontSize="18"/></StackPanel><TextBlock Style="{StaticResource Label}" FontSize="13" FontWeight="SemiBold" Text="ACTUAL VOLTAGE"/></StackPanel>
    <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActualCurrent}" FontFamily="Consolas" FontSize="42" FontWeight="SemiBold"/><TextBlock Text=" A" VerticalAlignment="Bottom" Margin="2,0,0,9" Foreground="{DynamicResource SecondaryBrush}" FontSize="18"/></StackPanel><TextBlock Style="{StaticResource Label}" FontSize="13" FontWeight="SemiBold" Text="ACTUAL CURRENT"/></StackPanel>
    <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActualPower}" FontFamily="Consolas" FontSize="42" FontWeight="SemiBold"/><TextBlock Text=" W" VerticalAlignment="Bottom" Margin="2,0,0,9" Foreground="{DynamicResource SecondaryBrush}" FontSize="18"/></StackPanel><TextBlock Style="{StaticResource Label}" FontSize="13" FontWeight="SemiBold" Text="ACTUAL POWER"/></StackPanel>
   </Grid>

   <Grid Margin="0,0,0,16" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock Style="{StaticResource Label}" Text="DEVICE SET VOLTAGE"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DeviceSetVoltage}" FontFamily="Consolas" FontSize="22"/><TextBlock Text=" V" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/></StackPanel></StackPanel></Border>
    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock Style="{StaticResource Label}" Text="DEVICE CURRENT LIMIT"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DeviceCurrentLimit}" FontFamily="Consolas" FontSize="22"/><TextBlock Text=" A" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/></StackPanel></StackPanel></Border>
   </Grid>

   <Grid IsEnabled="{Binding CanEditSettings}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Style="{StaticResource Label}" Text="REQUESTED SET VOLTAGE / V"/><TextBox Text="{Binding VoltageInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="19" Visibility="{Binding UsesContinuousVoltage, Converter={StaticResource BoolVisibility}}"/><ComboBox ItemsSource="{Binding AvailableVoltages}" SelectedItem="{Binding SelectedDiscreteVoltage}" FontFamily="Consolas" FontSize="19" Visibility="{Binding UsesDiscreteVoltage, Converter={StaticResource BoolVisibility}}" ToolTip="This channel supports only the voltage choices listed by the detected model."/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="{Binding CurrentInputLabel}"/><TextBox Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="19" IsEnabled="{Binding CurrentProgrammable}" ToolTip="Disabled when the detected model has a fixed-current auxiliary channel."/></StackPanel>
   </Grid>

   <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
    <Button Content="APPLY SETTINGS" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="16,9" MinWidth="132"/>
    <Button Content="{Binding OutputAction}" Command="{Binding OutputCommand}" Margin="0" Padding="16,9" MinWidth="118" FontWeight="SemiBold">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
       <Setter Property="Background" Value="#3A2C16"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding OutputOn}" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
         <Setter Property="Background" Value="#173328"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
   </StackPanel>

   <Grid Margin="0,14,0,0" IsEnabled="{Binding CanEditSettings}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Style="{StaticResource Label}" Text="SOFT WARNING ABOVE VOLTAGE / V (OPTIONAL)"/><TextBox Text="{Binding WarningVoltageInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="17" ToolTip="Visual warning only. Becomes active after APPLY SETTINGS. Leave blank to disable."/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="SOFT WARNING ABOVE CURRENT / A (OPTIONAL)"/><TextBox Text="{Binding WarningCurrentInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="17" ToolTip="Visual warning only. Becomes active after APPLY SETTINGS. Leave blank to disable."/></StackPanel>
   </Grid>
   <Border Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" CornerRadius="5" Padding="8,5" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}"><TextBlock Text="{Binding WarningStatus}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding WarningActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding CriticalWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>

   <Grid Margin="0,14,0,0" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel IsEnabled="{Binding CanEditSettings}"><TextBlock Style="{StaticResource Label}" Text="MAX CURRENT AUTO-OFF / A  (OPTIONAL)"/><TextBox Text="{Binding MaxCurrentAutoOffInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="18" ToolTip="Optional software protection. Enter or edit the value, then press APPLY SETTINGS to arm it. Leave blank and press APPLY SETTINGS to disable it. Editing alone never changes the active protection limit."/></StackPanel>
    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom"><TextBlock Text="{Binding MaxCurrentProtectionStatus}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" Text="The typed value becomes active only after APPLY SETTINGS. Software protection depends on polling/serial response time; it does not replace the GPP hardware OCP." TextWrapping="Wrap"/></StackPanel>
   </Grid>

   <Border Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Source regulation is inferred from live V/I telemetry and setpoints; CH1/CH2 load mode is read from the instrument (Load CV / CC / CR). Hardware OVP/OCP status readback remains device-command dependent." TextWrapping="Wrap"/></Border>

   <Border Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
    <StackPanel><TextBlock Style="{StaticResource Label}" Text="QUICK PRESETS — loads requested values only; hardware changes only after APPLY SETTINGS"/>
     <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preset name, e.g. 28V avionics"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="8,0,0,0"/>
      <Button Grid.Column="2" Content="LOAD" Command="{Binding LoadPresetCommand}" Margin="8,0,0,0"/>
      <Button Grid.Column="3" Content="SAVE" Command="{Binding SavePresetCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
      <Button Grid.Column="4" Content="DELETE" Command="{Binding DeletePresetCommand}" Margin="8,0,0,0"/>
     </Grid>
    </StackPanel>
   </Border>
  </StackPanel>
 </Border>
</UserControl>
