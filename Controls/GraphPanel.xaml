<UserControl x:Class="Dou_GW_Studio.Controls.GraphPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Dou_GW_Studio.Controls">
 <StackPanel>
  <WrapPanel Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding DataContext.Channels, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding IncludeInGraph}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding Window}" Width="140" Margin="12,0,12,0"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/><Button Content="CLEAR" Command="{Binding ClearCommand}"/><Button Content="EXPORT WINDOW CSV" Click="ExportWindowCsv_Click"/><CheckBox Content="Auto scale" IsChecked="{Binding AutoScale}"/></WrapPanel>
  <WrapPanel Margin="0,0,0,10">
   <CheckBox Content="Voltage" IsChecked="{Binding Voltage}"/>
   <CheckBox Content="Current" IsChecked="{Binding Current}"/>
   <CheckBox Content="Power" IsChecked="{Binding Power}"/>
   <CheckBox Content="Show set values" IsChecked="{Binding ShowSetValues}" ToolTip="Show/hide dashed Voltage Set and Current Limit reference traces without changing device settings." Margin="14,0,0,0"/>
   <CheckBox Content="Show markers" IsChecked="{Binding ShowMarkers}" ToolTip="Show/hide graph event markers and labels. Marker history is preserved." Margin="14,0,0,0"/>
  </WrapPanel>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="ADD MARKER" Command="{Binding AddMarkerCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><TextBox Text="{Binding MarkerNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="Add a note at the latest sample, e.g. Load connected / DUT reset / Test started" MinWidth="360"/></DockPanel></Border>
  <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Solid: actual  ·  Dashed: device setpoint (optional)  ·  Markers can be hidden without deleting events  ·  Left-click a trace for the time/value cursor  ·  PAUSE freezes data for inspection." Margin="0,0,0,10"/>
  <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding Voltage, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><c:LiveChartControl Graph="{Binding}" Signal="Voltage" Height="220"/><Button Content="⛶  VOLTAGE FULL SCREEN" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="9,5" Click="SignalFullScreen_Click" Tag="Voltage"/></Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Padding="10,7" Margin="4,4,4,2"><TextBlock Text="{Binding VoltageStats}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Border></Grid></Border>
  <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding Current, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><c:LiveChartControl Graph="{Binding}" Signal="Current" Height="220"/><Button Content="⛶  CURRENT FULL SCREEN" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="9,5" Click="SignalFullScreen_Click" Tag="Current"/></Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Padding="10,7" Margin="4,4,4,2"><TextBlock Text="{Binding CurrentStats}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Border></Grid></Border>
  <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding Power, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><c:LiveChartControl Graph="{Binding}" Signal="Power" Height="220"/><Button Content="⛶  POWER FULL SCREEN" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="9,5" Click="SignalFullScreen_Click" Tag="Power"/></Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Padding="10,7" Margin="4,4,4,2"><TextBlock Text="{Binding PowerStats}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Border></Grid></Border>
  <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Serial acquisition and chart rendering are decoupled. Polling may be set below 50 ms, while charts are refreshed at a controlled rate to keep the UI responsive. Actual sample time still depends on serial transactions." Margin="0,0,0,16"/>
 </StackPanel>
</UserControl>
