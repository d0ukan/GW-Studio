<Window x:Class="Dou_GW_Studio.GraphFullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dou_GW_Studio.Controls"
        Title="GW Studio — Graph"
        Width="1320" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Margin="0,0,0,10">
   <StackPanel>
    <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock Text="Windowed graph: drag the title bar between monitors · resize freely · maximize/minimize normally · Full Screen hides the Windows frame."
               Style="{StaticResource Muted}"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="FullScreenButton" Content="FULL SCREEN" Click="FullScreen_Click" ToolTip="Toggle true borderless full screen on the current monitor."/>
    <Button Content="MINIMIZE" Click="Minimize_Click" ToolTip="Minimize only this graph window."/>
    <Button x:Name="MaximizeButton" Content="MAXIMIZE" Click="MaximizeRestore_Click" ToolTip="Maximize or restore this graph window."/>
    <Button Content="CLOSE" Click="Close_Click" HorizontalAlignment="Right"/>
   </StackPanel>
  </DockPanel>

  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
   <WrapPanel>
    <ToggleButton Content="ALL ON / OFF" IsChecked="{Binding AllOutputsOn, Mode=OneWay}" Command="{Binding AllOutputToggleCommand}" Style="{StaticResource OutputToggleButton}"/>
    <ItemsControl ItemsSource="{Binding Channels}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding QuickOutputLabel}" IsChecked="{Binding OutputOn, Mode=OneWay}" Command="{Binding QuickOutputCommand}" Style="{StaticResource OutputToggleButton}"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="ALL OUTPUT OFF" Command="{Binding AllOffCommand}" Style="{StaticResource DangerButton}" Margin="12,0,0,0"/>
   </WrapPanel>
  </Border>

  <WrapPanel Grid.Row="2" Margin="0,0,0,10">
   <Button Content="{Binding Graph.PauseLabel}" Command="{Binding Graph.PauseCommand}" Style="{StaticResource PrimaryButton}"/>
   <Button Content="CLEAR" Command="{Binding Graph.ClearCommand}"/>
   <Button Content="RESET / AUTOSIZE" Click="ResetView_Click" ToolTip="Restore the graph to its original time window and Y-axis scale."/>
   <ItemsControl ItemsSource="{Binding Channels}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding IncludeInGraph}"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <CheckBox Content="Auto scale" IsChecked="{Binding Graph.AutoScale}"/>
   <CheckBox Content="Show set values" IsChecked="{Binding Graph.ShowSetValues}" ToolTip="Show/hide dashed Voltage Set and Current Limit reference traces." Margin="12,0,0,0"/>
   <CheckBox Content="Show markers" IsChecked="{Binding Graph.ShowMarkers}" ToolTip="Show/hide event markers without deleting them." Margin="12,0,0,0"/>
   <ComboBox ItemsSource="{Binding Graph.Windows}" SelectedItem="{Binding Graph.Window}" Width="145" Margin="10,0,0,0"/>
  </WrapPanel>

  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
   <c:LiveChartControl x:Name="Chart" Graph="{Binding Graph}" Interactive="True"/>
  </Border>

  <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
   <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
  </Border>
 </Grid>
</Window>
