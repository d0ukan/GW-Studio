<Window x:Class="Dou_GW_Studio.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW Studio — Update Available" Width="520" SizeToContent="Height"
        MinHeight="330" MaxHeight="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/AppIcon.ico">
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="22">
  <StackPanel>
   <TextBlock Text="New version available" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
   <TextBlock x:Name="IntroText" Text="Updates are optional. GW Studio will only download or install after you choose Update Now." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,18"/>

   <Grid Margin="0,0,0,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="Installed" Style="{StaticResource Label}"/>
    <TextBlock Grid.Column="1" x:Name="InstalledText" FontFamily="Consolas" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Available" Style="{StaticResource Label}" Margin="0,8,0,0"/>
    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AvailableText" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
   </Grid>

   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/></ScrollViewer>
    </StackPanel>
   </Border>

   <TextBlock x:Name="StatusText" Text="Ready to update." Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,6"/>
   <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,16"/>

   <DockPanel LastChildFill="False">
    <Button x:Name="LaterButton" Content="LATER" Click="Later_Click" MinWidth="110" DockPanel.Dock="Right"/>
    <Button x:Name="UpdateButton" Content="UPDATE NOW" Click="Update_Click" Style="{StaticResource PrimaryButton}" MinWidth="130" DockPanel.Dock="Right" Margin="0,0,8,0"/>
   </DockPanel>
  </StackPanel>
 </Border>
</Window>
